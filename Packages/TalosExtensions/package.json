{
  "name": "talos-extensions",
  "private": true,
  "type": "module",
  "workspaces": [
    "sdk",
    "built-in-actions"
  ],
  "scripts": {
    "build": "npm run build --workspace @talos/built-in-actions",
    "test": "node --test tests/*.test.mjs",
    "format": "biome format --write sdk built-in-actions/src tests *.json",
    "format:check": "biome format sdk built-in-actions/src tests *.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  },
  "engines": {
    "node": ">=24"
  }
}

{
  "id": "dev.talos.host-test",
  "name": "Host integration fixture",
  "description": "Inspect selected files in a native window or generate a report in the background.",
  "version": "1.0.0",
  "sdkVersion": 1,
  "minimumMacOS": "15.0",
  "architectures": [
    "arm64",
    "x86_64"
  ],
  "actions": [
    {
      "id": "inspect",
      "title": "Inspect",
      "symbol": "doc.text.magnifyingglass",
      "acceptedTypes": [
        "public.item"
      ],
      "minimumFiles": 1
    },
    {
      "id": "report",
      "title": "Report",
      "symbol": "doc.badge.gearshape",
      "acceptedTypes": [
        "public.item"
      ],
      "minimumFiles": 1
    }
  ],
  "runtime": "javascript",
  "entrypoint": "extension.mjs"
}
